# Yalnızca `npm run dev` sırasında geçerlidir.
# Onaylanmamış (approved: false) tedavileri "Taslak" etiketiyle önizlemek için 1 yapın.
# Yayın derlemesinde (npm run build) bu değer okunmaz; onaylanmamış tedaviler asla görünmez.
NEXT_PUBLIC_PREVIEW_DRAFTS=1

# Online randevu ve hasta hesabını ÖRNEK takvimle denemek için 1 yapın.
# Yayın derlemesinde okunmaz; yayında açmak için src/config/site.ts → booking.
NEXT_PUBLIC_PREVIEW_BOOKING=1
