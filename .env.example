# Bu dosyayı `.env.local` (geliştirme) veya sunucudaki ortam değişkenleri
# olarak kopyalayıp doldurun. Gerçek değerleri ASLA depoya eklemeyin.

# Sitenin yayın adresi (sonunda / olmadan). Google girişi için gerekli.
APP_URL=https://www.ornek-alanadi.com

# Google ile giriş (Google Cloud Console → API'ler ve Hizmetler → Kimlik bilgileri
# → OAuth istemci kimliği → Web uygulaması). Yetkilendirilmiş yönlendirme URI'si:
#   https://www.ornek-alanadi.com/api/auth/google/callback
# Boş bırakılırsa "Google ile devam et" butonu görünmez.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# İsteğe bağlı: veritabanı ve hasta dosyalarının konumu (varsayılan: ./data)
# DATABASE_PATH=/var/lib/sardes/sardes.db
# FILES_PATH=/var/lib/sardes/files
